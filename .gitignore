# Flutter build outputs
client/build/
client/.dart_tool/
client/.flutter-plugins*

# Flutter artifacts (release builds)
client/artifacts-*/

# ZIP packages (root level only)
/*.zip

# Log and text output files
*.log
*.tmp
*.swp
/*.txt
/*.json

# PowerShell / Shell scripts (root level only)
/*.ps1
/*.sh

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Environment / sensitive files
config.php.bak

# Uploaded files (keep .htaccess)
file/*
!file/.htaccess

# Backup directories (any date-stamped dirs)
*-*-*-*-*/
*-*-*-*-*-*/

# Temp / debug files
debug_*
deploy_api.*
*-test.*
test_*
create_zip.php
create_update*
make_incremental.*
push_fix.*
backup.*

# Trae workspace
.trae/